# ====================================================================
# KanaShop Production Environment Configuration Template
# ====================================================================

PORT=5000
NODE_ENV=production

# Cryptographic Keys (Must be 32+ characters of high entropy in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_production_secure_jwt_secret_token_here_at_least_32_characters

# AES-256-GCM 32-Character Encryption Key for Thai National ID & PII
ENCRYPTION_KEY=your_production_32_char_key_here!

# Frontend Web Origin for CORS & Socket.IO
FRONTEND_URL=https://kanashop.example.com

# Official PromptPay Mobile / Tax ID for Payment QR Code
PROMPTPAY_ID=0812345678
